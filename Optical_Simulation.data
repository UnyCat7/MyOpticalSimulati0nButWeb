#version 300 es
precision highp float;

struct Material {
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
    float shininess;
};
uniform Material material;

in vec3 ourNormal;
in vec2 TextureCord;
in vec3 FragPos;

uniform sampler2D texture1;
uniform vec3 lightPos;
uniform vec3 viewPos;
uniform vec3 lightColor;

out vec4 FragColor;

void main()
{
    // Ambient
    vec3 ambient = lightColor * material.ambient;

    // Diffuse
    vec3 norm = normalize(ourNormal);
    vec3 lightDir = normalize(lightPos - FragPos);
    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = lightColor * (material.diffuse * diff);

    // Specular
    vec3 viewDir = normalize(viewPos - FragPos);
    vec3 reflectDir = reflect(-lightDir, norm);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = lightColor * (material.specular * spec);

    vec3 color = ambient + diffuse + specular;
    FragColor = vec4(color, 1.0) * texture(texture1, TextureCord);
}
#version 300 es //330 core

out vec4 FragColor;

in vec3 ourNoraml;
in vec2 TextureCord;

uniform sampler2D texture1;
//uniform sampler2D texture2;

void main()
{
	//FragColor = ourColor;			!!No more ourColor
	FragColor = texture(texture1, TextureCord);
	//FragColor = mix(texture(texture1, TextureCord), texture(texture2, TextureCord), 0.5);
    //FragColor = texture(texture1, TextureCord) * vec4(ourColor);  !!No more ourColor
}#version 300 es
precision highp float;//Some 300 es shift

//ty https://www.youtube.com/watch?v=RqrkVmj-ntM

out vec4 FragColor;
in vec3 worldPos;
uniform vec3 uViewPos;


uniform float uGridSize;// = 100.0;
uniform float uCellSize;// = 0.02;
uniform float uMinCellSizeInPixels;// = 2.0;
uniform vec4 uGridColorThick;// = vec4(0.2, 0.2, 0.2, 0.8);
uniform vec4 uGridColorThin;// = vec4(0.6, 0.6, 0.6, 0.3);
uniform float gridFallofSize;// = 1.0;


uniform vec4 axisXColor;     // e.g. vec3(1.0, 0.0, 0.0)
uniform vec4 axisZColor;     // e.g. vec3(0.0, 0.0, 1.0)

float log10(float x) {
    float f = log(x) / log(10.0);
    return f;
}

float satf(float x) {
    float f = clamp(x, 0.0, 1.0);
    return f;
}

vec2 satv(vec2 x) {
    vec2 v = clamp(x, vec2(0.0), vec2(1.0));
    return v;
}

float max2(vec2 v) {
    float f = max(v.x, v.y);
    return f;
}


void main()
{
    float lx = length(vec2(dFdx(worldPos.x), dFdy(worldPos.x)));
    float ly = length(vec2(dFdx(worldPos.z), dFdy(worldPos.z)));

    vec2 dudv = vec2(lx, ly);
    float l = length(dudv);

    dudv *= 4.0;
    dudv = max(dudv, vec2(1e-5));

    float LOD = max(0.0, log10(l * uMinCellSizeInPixels / uCellSize) + 1.0);

    float CellSuzeLod0 = uCellSize * pow(10.0, floor(LOD));
    float CellSuzeLod1 = CellSuzeLod0 * 10.0;
    float CellSuzeLod2 = CellSuzeLod1 * 10.0;

    vec2 modDivDudv = mod(worldPos.xz, CellSuzeLod0) / dudv;
    float lod0a = max2(vec2(1.0) - abs(satv(modDivDudv) * 2.0 - vec2(1.0)));

    modDivDudv = mod(worldPos.xz, CellSuzeLod1) / dudv;
    float lod1a = max2(vec2(1.0) - abs(satv(modDivDudv) * 2.0 - vec2(1.0)));

    modDivDudv = mod(worldPos.xz, CellSuzeLod2) / dudv;
    float lod2a = max2(vec2(1.0) - abs(satv(modDivDudv) * 2.0 - vec2(1.0)));

    float LOD_Fade = fract(LOD);

    vec4 Color;
    float Lm2 = l * 2.0;

    if (lod2a > 0.0 ) {
        if (worldPos.x <= Lm2 && worldPos.x >= -Lm2){
            Color = axisXColor;
            Color.a *= lod2a;
        }else{
            if (worldPos.z <= Lm2 && worldPos.z >= -Lm2){
                Color = axisZColor;
                Color.a *= lod2a;
            }else{
                Color = uGridColorThick;
                Color.a *= lod2a;
            }
        }
    } else {
        if (lod1a > 0.0) {
            Color = mix(uGridColorThick, uGridColorThin, LOD_Fade);
            Color.a *= lod1a;
        }else{
            Color = uGridColorThin;
            Color.a *= (lod0a * (1.0 - LOD_Fade));
        }
    }

    float dist = length(worldPos.xz - uViewPos.xz);
    float OpacityFalloff = 1.0 - smoothstep(uGridSize * 0.8, uGridSize, dist);
    Color.a *= OpacityFalloff;

    FragColor = Color;
}
#version 300 es
//ty https://www.youtube.com/watch?v=RqrkVmj-ntM

layout (location = 0) in vec3 aPos;

uniform mat4 uView;
uniform mat4 uProjection;
uniform mat4 uModel;

out vec3 worldPos;

void main()
{
    vec4 world = uModel * vec4(aPos, 1.0);
    worldPos = world.xyz;

    gl_Position = uProjection * uView * world;
}
