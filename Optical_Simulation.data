}#version 300 es
precision highp float;

in vec3 worldPos;
flat in vec3 flatNormal;
in vec4 instanceColor;

out vec4 FragColor;

vec3 lightPos   = vec3(50000.0, 50000.0, 50000.0);
vec3 lightColor = vec3(1.0);

void main()
{
    vec3 N = normalize(flatNormal);
    vec3 L = normalize(lightPos - worldPos);

    float diff = max(dot(N, L), 0.0);
    float ambient = 0.6;

    vec3 color = (ambient + diff) * instanceColor.rgb * lightColor;
    FragColor = vec4(color, instanceColor.a);
}
#version 300 es
precision highp float;

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in mat4 instanceMatrix;
layout (location = 6) in vec4 vinstanceColor;

uniform mat4 uView;
uniform mat4 uProjection;

out vec3 worldPos;
flat out vec3 flatNormal;
out vec4 instanceColor;

void main()
{
    vec4 world = instanceMatrix * vec4(aPos, 1.0);
    worldPos = world.xyz;

    mat3 normalMatrix = mat3(transpose(inverse(instanceMatrix)));
    flatNormal = normalize(normalMatrix * aNormal);

    instanceColor = vinstanceColor;
    gl_Position = uProjection * uView * world;
}
#version 300 es
precision highp float;

in vec3 worldPos;
in vec3 fragNormal;
in vec4 instanceColor;

out vec4 FragColor;

vec3 lightPos   = vec3(50000.0, 50000.0, 50000.0);
vec3 lightColor = vec3(1.0);

void main()
{
    vec3 N = normalize(fragNormal);
    vec3 L = normalize(lightPos - worldPos);

    float diff = max(dot(N, L), 0.0);
    float ambient = 0.6;

    vec3 color = (ambient + diff) * instanceColor.rgb * lightColor;
    FragColor = vec4(color, instanceColor.a);
}
