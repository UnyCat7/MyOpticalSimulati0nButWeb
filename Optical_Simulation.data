}
#version 300 es
precision highp float;

out vec4 FragColor;

in vec3 worldPos;
in vec3 fragNormal;

uniform vec3 uColor;
uniform float uAlpha;

vec3 lightPos   = vec3(35000.0, 55000.0, 45000.0);
vec3 lightColor = vec3(1.0);

void main()
{
    vec3 N = normalize(fragNormal);
    vec3 L = normalize(lightPos - worldPos);

    // normal diffuse term (front lighting)
    float diff = max(dot(N, L), 0.0);

    // darkening term (opposite side of light, only when facing away)
    float dark = max(dot(N, -L), 0.0);

    float ambient = 0.4;

    // light only controls front
    float lit = ambient + diff;

    // shadow/darkening only affects back
    float shading = 1.0 - 0.6 * dark;   // reduce brightness on back side

    float brightness = lit * shading;

    vec3 color = brightness * uColor * lightColor;
    FragColor = vec4(color, uAlpha);
}
#version 300 es
precision highp float;

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;

out vec3 worldPos;
out vec3 fragNormal;

uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProjection;

void main()
{
    vec4 world = uModel * vec4(aPos, 1.0);
    worldPos = world.xyz;

    mat3 normalMatrix = mat3(transpose(inverse(uModel)));
    fragNormal = normalize(normalMatrix * aNormal);

    gl_Position = uProjection * uView * uModel * vec4(aPos, 1.0);
}
#version 300 es
precision highp float;

out vec4 FragColor;

// Uniform for outline color
uniform vec4 uColor;

void main()
{
    FragColor = uColor; // solid RGBA
}
#version 300 es
precision highp float;

layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;

uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProjection;
uniform float uOutlineRad; // outline thickness in view space

out vec3 vNormal;
out vec3 vPosition; // pass to fragment shader if needed

void main()
{
    // Transform vertex to view space
    vec4 viewPos = uView * uModel * vec4(aPos, 1.0);
    vec3 viewNormal = mat3(transpose(inverse(uView * uModel))) * aNormal;

    // Extrude along normal in view space for outline
    viewPos.xyz += normalize(viewNormal) * uOutlineRad;

    gl_Position = uProjection * viewPos;

    // Pass through for fragment shader (optional)
    vNormal = viewNormal;
    vPosition = viewPos.xyz;
}
#version 300 es //330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 normal;
layout (location = 2) in vec2 aTexturCord;

out vec3 ourNormal;
out vec2 TextureCord;
out vec3 FragPos;

uniform mat4 transform;
uniform mat4 view;
uniform mat4 projection;

void main()
{
   gl_Position = projection * view * transform * vec4(aPos, 1.0);
   ourNormal = normalize(mat3(transpose(inverse(transform))) * normal);
   TextureCord = aTexturCord;

   FragPos = vec3(transform * vec4(aPos, 1.0));
}



#version 300 es //330 core

